PUBLIC_URL=https://inspector.example.com
CAMPUS_BASE_URL=https://api.campus.example.com
# Exact Campus JWT issuer; this may differ from CAMPUS_BASE_URL.
CAMPUS_ISSUER=https://campus.example.com
# Set a strong random password before starting. Never commit the resulting .env.
INSPECTOR_PASSWORD=
DATA_DIR=/data
ALLOW_LOCAL_HTTP=false
